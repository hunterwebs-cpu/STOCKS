# ── Reddit API (create an app at https://www.reddit.com/prefs/apps) ──────────
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=buzz-screener/1.0 by u/your_username

# Subreddits to scan (comma-separated, no r/ prefix)
SUBREDDITS=wallstreetbets,stocks,investing,options,pennystocks,stockmarket
# How many posts to pull per subreddit per listing
REDDIT_POST_LIMIT=100
# Top-level comments to scan per post
REDDIT_COMMENTS_PER_POST=50

# ── StockTwits (public API, no key needed) ────────────────────────────────────
STOCKTWITS_SLEEP=0.5
STOCKTWITS_RATE_LIMIT_BACKOFF=60

# ── Buzz detection ────────────────────────────────────────────────────────────
# Flag tickers whose mention z-score is at or above this many std devs
Z_SCORE_THRESHOLD=1.2
# Rolling baseline window (days, excludes today)
BASELINE_DAYS=30
# Minimum prior scrape days required before a ticker can be flagged
MIN_HISTORY_DAYS=5

# ── Technicals ────────────────────────────────────────────────────────────────
RSI_PERIOD=21

# ── Storage ───────────────────────────────────────────────────────────────────
# Defaults (relative to repo) are used when left blank
DB_PATH=
REPORT_DIR=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=you@example.com
# Comma-separated recipients
EMAIL_TO=you@example.com
