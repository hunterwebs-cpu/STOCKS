# Reddit API credentials (get from https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=NightlyBuzzScreener/1.0 by YourUsername

# Buzz detection threshold (z-score)
BUZZ_Z_THRESHOLD=1.2

# Minimum days of history before flagging a ticker
MIN_HISTORY_DAYS=5

# Rolling baseline window in days
BASELINE_WINDOW_DAYS=30

# SQLite database path
DB_PATH=buzz_mentions.db

# Output report directory
REPORT_DIR=output_reports

# Email settings (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=recipient@example.com
EMAIL_SUBJECT=Nightly Buzz Report

# Set to true to skip sending email (useful for testing)
EMAIL_DRY_RUN=false
